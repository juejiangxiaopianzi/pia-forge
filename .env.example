# ── Database (PostgreSQL) ────────────────────────────────────────────────
# 阿里云 RDS PostgreSQL 外网连接串（先用本地 docker-compose 也行）
DATABASE_URL="postgresql://pia:pia_dev@localhost:5432/pia_forge?schema=public"

# ── Next Auth ────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# 飞书 OAuth（可选，先用邮箱登录也可以）
LARK_CLIENT_ID=""
LARK_CLIENT_SECRET=""

# ── Aliyun OSS（附件证据存储）────────────────────────────────────────────
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET="pia-forge-attachments"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""

# ── API & MCP 鉴权 ───────────────────────────────────────────────────────
# 给系统内的 API Token 签名用 · 必须改成长随机字符串
API_TOKEN_SIGNING_SECRET="change-me-to-a-long-random-string-for-api-tokens"

# 是否启用 MCP server（默认 true）
ENABLE_MCP_SERVER="true"

# 是否启用 REST API v1（默认 true）
ENABLE_REST_API="true"

# ── 实例配置 ─────────────────────────────────────────────────────────────
APP_NAME="PIA Forge"
APP_LOCALE="zh-CN"

# ── 注意：PIA Forge 不内置 LLM ────────────────────────────────────────────
# 设计哲学：让用户带自己的 Agent（Claude Code / Cursor / 自建）来对接。
# 通过 REST API、MCP Server、Skill Pack 三层接口开放给外部 Agent 调用。
# 详见 docs/architecture.md。
