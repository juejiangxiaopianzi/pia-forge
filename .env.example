# ── Database (PostgreSQL) ────────────────────────────────────────────────
# 阿里云 RDS PostgreSQL 外网连接串（先用本地 docker-compose 也行）
DATABASE_URL="postgresql://pia:pia_dev@localhost:5432/pia_forge?schema=public"

# ── Next Auth ────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# 飞书 OAuth（可选，先用邮箱登录也可以）
LARK_CLIENT_ID=""
LARK_CLIENT_SECRET=""

# ── Aliyun OSS（附件证据存储）────────────────────────────────────────────
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET="pia-forge-attachments"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""

# ── LLM 辅助起草（可选，先留空）─────────────────────────────────────────
# 用于自动生成风险/措施草案。支持 OpenAI 兼容协议。
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ── 实例配置 ─────────────────────────────────────────────────────────────
APP_NAME="PIA Forge"
APP_LOCALE="zh-CN"
