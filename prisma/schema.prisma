// PIA Forge · Data Model
// 设计目标：把多维表格里跑通的「7 张表」翻译成可被 Prisma 维护的关系型 schema，
// 同时为未来通用化（多组织 / 多项目 / 评估留痕）留好结构。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// 组织 & 用户
// ────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        Membership[]
  projects       PiaProject[]
  apiTokens      ApiToken[]
  agents         Agent[]
  evaluations    Evaluation[]
  sources        Source[]
  knowledgeBases KnowledgeBase[]
  InviteCode     InviteCode[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  larkOpenId   String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  rolesOwned        PiaRole[]    @relation("RoleOwner")
  itemsOwned        DataItem[]   @relation("ItemOwner")
  scenesOwned       Scenario[]   @relation("ScenarioOwner")
  risksFiled        Risk[]       @relation("RiskFiler")
  controlsLed       Mitigation[] @relation("ControlOwner")
  controlsValidated Mitigation[] @relation("ControlValidator")
  conclusionsSigned Conclusion[] @relation("ConclusionSigner")
  auditLogs         AuditLog[]
  apiTokens         ApiToken[]
  agentsOwned       Agent[]      @relation("AgentOwner")
  invitesCreated    InviteCode[] @relation("InviteCreator")
  invitesUsed       InviteCode?  @relation("InviteUsedBy")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ────────────────────────────────────────────────────────────────────────
// 01 评估总览（PiaProject）
// ────────────────────────────────────────────────────────────────────────

model PiaProject {
  id             String         @id @default(cuid())
  organizationId String
  /// Module / 评估类型 · 决定本评估属于哪个合规场景（PIA / AUDIT / FILING / NOTICE / INCIDENT）
  /// 各 module 共用底层 7 张表，只在 UI 层和 prompt 层做差异化
  assessmentType AssessmentType @default(PIA)
  code           String // e.g. PIA-LP-001 / AUDIT-Q2-001
  title          String
  scope          String         @db.Text
  purpose        String         @db.Text
  legalBases     String[]
  startedAt      DateTime
  targetDoneAt   DateTime?
  leaderId       String?
  teamUserIds    String[]
  overallVerdict OverallVerdict @default(IN_PROGRESS)
  residualLevel  RiskLevel      @default(UNRATED)
  reviewTriggers String         @db.Text
  approvalState  ApprovalState  @default(DRAFT)
  approvedAt     DateTime?
  approverId     String?
  version        String         @default("v0.1")
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          PiaRole[]
  dataItems      DataItem[]
  scenarios      Scenario[]
  risks          Risk[]
  mitigations    Mitigation[]
  conclusions    Conclusion[]
  auditLogs      AuditLog[]
  fieldRevisions FieldRevision[]

  @@unique([organizationId, code])
}

/// 评估类型 · 决定 module 路由
/// PIA      个人信息保护影响评估（PIPL §55-56）
/// AUDIT    合规审计（内审 / 子公司 / 外部审计）
/// FILING   申报与备案台账（数据出境申报 / 承诺函库）
/// NOTICE   告知与同意版本管理（隐私政策 / 弹窗版本）
/// INCIDENT 事件响应与处置（数据事件 / 客诉 / 监管约谈）
enum AssessmentType {
  PIA
  AUDIT
  FILING
  NOTICE
  INCIDENT
}

enum OverallVerdict {
  IN_PROGRESS
  ACCEPTABLE
  CONDITIONAL
  UNACCEPTABLE
}

enum ApprovalState {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGE_REQUESTED
}

enum RiskLevel {
  UNRATED
  LOW
  MEDIUM
  HIGH
}

// ────────────────────────────────────────────────────────────────────────
// 02 角色与职责（PiaRole）
// ────────────────────────────────────────────────────────────────────────

model PiaRole {
  id           String         @id @default(cuid())
  projectId    String
  roleType     RoleType
  shortLabel   String
  userId       String?
  organization String? // 部门
  duties       String         @db.Text
  raciFlags    RaciFlag[]
  stages       PiaStage[]
  deliverable  String         @db.Text
  dueAt        DateTime?
  status       DeliveryStatus @default(NOT_STARTED)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project PiaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?      @relation("RoleOwner", fields: [userId], references: [id])
}

enum RoleType {
  PIA_LEAD
  LEGAL_LEAD
  C_END_PRODUCT
  B_END_PRODUCT
  DATA_TEAM
  ENGINEERING
  SECURITY_AUDIT
  COMPLIANCE_OFFICER
  EXEC_APPROVER
  EXTERNAL_COUNSEL
}

enum RaciFlag {
  R
  A
  C
  I
}

enum PiaStage {
  S0_SCOPE
  S1_DATAFLOW
  S2_IDENTIFY
  S3_RATE
  S4_MITIGATE
  S5_REPORT
}

enum DeliveryStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  OVERDUE
  BLOCKED
}

// ────────────────────────────────────────────────────────────────────────
// 03 数据流与信息项清单（DataItem）
// ────────────────────────────────────────────────────────────────────────

model DataItem {
  id                String             @id @default(cuid())
  projectId         String
  code              String // DI-001
  name              String
  techName          String?
  classification    PiClass            @default(GENERAL)
  sensitiveSub      SensitiveSubtype[]
  legalBasis        LegalBasis?
  legalReasoning    String             @db.Text
  isOutbound        Boolean            @default(false)
  stages            FlowStage[]
  necessity         String             @db.Text
  status            ComplianceStatus   @default(PENDING)
  ownerId           String?
  notes             String?            @db.Text
  /// 最后编辑者标识 · 字段级历史走 FieldRevision
  lastEditActorType ActorType?
  lastEditUserId    String?
  lastEditAgentId   String?
  lastEditAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  project   PiaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?      @relation("ItemOwner", fields: [ownerId], references: [id])
  scenarios Scenario[] @relation("DataItemScenarios")
  risks     Risk[]     @relation("DataItemRisks")

  @@unique([projectId, code])
}

enum PiClass {
  GENERAL
  SENSITIVE
  NON_PI
  DISPUTED // 存争议待裁定（典型：简历照片）
}

enum SensitiveSubtype {
  BIOMETRIC
  SPECIFIC_IDENTITY
  MEDICAL_HEALTH
  FINANCIAL
  WHEREABOUTS
  MINOR_UNDER_14
  RELIGION
  SEXUAL_ORIENTATION
  UNDISCLOSED_CRIMINAL
}

enum LegalBasis {
  SEPARATE_CONSENT
  GENERAL_CONSENT
  CONTRACT_NECESSITY
  LEGAL_OBLIGATION
  PUBLIC_INTEREST
  EMERGENCY
  PUBLIC_INFO
  OTHER
}

enum FlowStage {
  COLLECT
  STORE
  PROCESS
  OUTBOUND
  RECEIVER_USE
  DELETE
}

enum ComplianceStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  PENDING
}

// ────────────────────────────────────────────────────────────────────────
// 04 出境场景清单（Scenario）
// ────────────────────────────────────────────────────────────────────────

model Scenario {
  id              String           @id @default(cuid())
  projectId       String
  code            String // SC-001
  name            String
  description     String           @db.Text
  receiverType    ReceiverType
  receiverRegions String           @db.Text
  techPath        String           @db.Text
  encryption      String           @db.Text
  annualVolume    BigInt?
  shareRatio      String?
  triggerRules    String           @db.Text
  safeguards      String           @db.Text
  scenarioRisk    String           @db.Text
  legalBases      LegalBasis[]
  ownerId         String?
  status          ComplianceStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project   PiaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?      @relation("ScenarioOwner", fields: [ownerId], references: [id])
  dataItems DataItem[] @relation("DataItemScenarios")
  risks     Risk[]     @relation("ScenarioRisks")

  @@unique([projectId, code])
}

enum ReceiverType {
  FOREIGN_CORP_DOMESTIC
  DOMESTIC_OVERSEAS_IP
  TRUE_OVERSEAS
  PLATFORM_RECOMMENDER
  USER_DRIVEN_OVERSEAS
  OTHER
}

// ────────────────────────────────────────────────────────────────────────
// 05 风险登记册（Risk）
// ────────────────────────────────────────────────────────────────────────

model Risk {
  id                String       @id @default(cuid())
  projectId         String
  code              String // R-001
  name              String
  category          RiskCategory
  description       String       @db.Text
  likelihood        Int // 1-5
  severity          Int // 1-5
  /// initial risk value = likelihood × severity (derived at read-time)
  legalClauses      String       @db.Text
  filerId           String?
  identifiedAt      DateTime     @default(now())
  strategy          RiskStrategy
  notes             String?      @db.Text
  /// 当前最后编辑者（denormalized for list view 性能）· 字段级历史走 FieldRevision
  lastEditActorType ActorType?
  lastEditUserId    String?
  lastEditAgentId   String?
  lastEditAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project     PiaProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filer       User?        @relation("RiskFiler", fields: [filerId], references: [id])
  dataItems   DataItem[]   @relation("DataItemRisks")
  scenarios   Scenario[]   @relation("ScenarioRisks")
  mitigations Mitigation[]

  @@unique([projectId, code])
}

enum RiskCategory {
  LEGAL_BASIS
  NECESSITY
  NOTICE
  CONSENT
  RECEIVER
  TECH_SECURITY
  RIGHTS_HARM
  CROSS_BORDER_JURISDICTION
  DATA_QUALITY
  TRACEABILITY
}

enum RiskStrategy {
  MITIGATE
  TRANSFER
  ACCEPT
  AVOID
}

// ────────────────────────────────────────────────────────────────────────
// 06 控制措施与残余风险（Mitigation）
// ────────────────────────────────────────────────────────────────────────

model Mitigation {
  id                 String          @id @default(cuid())
  projectId          String
  code               String // C-001
  riskId             String
  name               String
  controlType        ControlType
  details            String          @db.Text
  ownerId            String?
  dueAt              DateTime?
  status             ControlStatus   @default(NOT_STARTED)
  residualLikelihood Int?
  residualSeverity   Int?
  acceptable         AcceptanceLevel @default(NOT_EVALUATED)
  acceptReason       String?         @db.Text
  evidenceUrls       String[]
  validatorId        String?
  validatedAt        DateTime?
  notes              String?         @db.Text
  /// 最后编辑者标识 · 字段级历史走 FieldRevision
  lastEditActorType  ActorType?
  lastEditUserId     String?
  lastEditAgentId    String?
  lastEditAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project   PiaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  risk      Risk       @relation(fields: [riskId], references: [id], onDelete: Cascade)
  owner     User?      @relation("ControlOwner", fields: [ownerId], references: [id])
  validator User?      @relation("ControlValidator", fields: [validatorId], references: [id])

  @@unique([projectId, code])
}

enum ControlType {
  TECHNICAL
  PROCESS
  LEGAL
  PRODUCT_UX
  TRAINING
  AUDIT
}

enum ControlStatus {
  NOT_STARTED
  DESIGNING
  IMPLEMENTING
  LANDED_PENDING_REVIEW
  VALIDATED
  OVERDUE
}

enum AcceptanceLevel {
  ACCEPTABLE
  CONDITIONAL
  UNACCEPTABLE
  NOT_EVALUATED
}

// ────────────────────────────────────────────────────────────────────────
// 07 结论与签字（Conclusion）
// ────────────────────────────────────────────────────────────────────────

model Conclusion {
  id                String          @id @default(cuid())
  projectId         String
  title             String
  evaluationTarget  String          @db.Text
  overallVerdict    String          @db.Text
  residualLevel     RiskLevel
  highRiskSummary   String          @db.Text
  businessAdvice    String          @db.Text
  regulatorTone     String          @db.Text
  signerId          String?
  signerRoleLabel   String?
  signedAt          DateTime?
  signatureUrl      String?
  nextReviewAt      DateTime?
  reviewTriggers    String          @db.Text
  reviewerId        String?
  state             ConclusionState @default(DRAFT)
  /// 最后编辑者标识 · 字段级历史走 FieldRevision
  lastEditActorType ActorType?
  lastEditUserId    String?
  lastEditAgentId   String?
  lastEditAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project PiaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signer  User?      @relation("ConclusionSigner", fields: [signerId], references: [id])
}

enum ConclusionState {
  DRAFT
  SIGNED
  REVOKED
}

// ────────────────────────────────────────────────────────────────────────
// AuditLog — 谁动过什么字段，对监管展示用
// ────────────────────────────────────────────────────────────────────────

model AuditLog {
  id                   String      @id @default(cuid())
  projectId            String?
  resource             String // PiaProject / Risk / Mitigation 等
  resourceId           String
  action               String // create / update / delete / sign / evaluate
  source               AuditSource @default(WEB)
  actorType            ActorType   @default(HUMAN)
  /// 兼容字段 · actorType=HUMAN 时指向 User
  userId               String?
  /// actorType=AGENT 时指向 Agent
  actorAgentId         String?
  /// 当时 Agent 的能力快照
  actorAgentSnapshotId String?
  diff                 String?     @db.Text // JSON diff
  createdAt            DateTime    @default(now())

  project PiaProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([actorAgentId])
  @@index([resource, resourceId])
}

enum AuditSource {
  WEB // 网页人工操作
  REST_API // 外部 Agent 走 REST API
  MCP // 外部 LLM Agent 走 MCP
  SEED // seed 脚本初始化
  MIGRATION // 数据迁移
}

// ────────────────────────────────────────────────────────────────────────
// API Token · 给外部 Agent / 第三方系统接入用
// ────────────────────────────────────────────────────────────────────────

model ApiToken {
  id             String       @id @default(cuid())
  organizationId String
  userId         String // 这个 token 属于哪个 user（凭据归属）
  agentId        String? // 关联的 Agent 身份（v0.2 起强烈推荐填）
  name           String // 用户起的备注，如 "我的 Claude Code"
  prefix         String // 显示前 8 位，方便区分（如 pia_a1b2c3d4）
  hashedToken    String       @unique // 实际 token 的 sha256
  scopes         TokenScope[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([agentId])
}

// ────────────────────────────────────────────────────────────────────────
// Agent · 一等公民身份（系统颁发的长期 ID，绑定到具体 User）
// ────────────────────────────────────────────────────────────────────────
// 设计原则：
// - id 是 system-issued、长期不变的「身份」（不是凭据）
// - 同一个 Agent 内部可迭代 N 版，身份不变，版本走 AgentSnapshot
// - 不追求跨系统统一标识 —— PIA Forge 自己颁就够
// - Owner 是它代表的人（黄越的 Agent / 王某某的 Agent）

model Agent {
  id             String      @id @default(cuid()) // 形如 agt_xxxxxxxx，由 lib 层加前缀
  organizationId String
  ownerId        String // 它代表谁
  displayName    String // "黄越的 Claude Code" / "PIA 风险起草助手"
  description    String?     @db.Text
  status         AgentStatus @default(ACTIVE)
  retiredAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User            @relation("AgentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  snapshots    AgentSnapshot[]
  apiTokens    ApiToken[]

  @@index([organizationId])
  @@index([ownerId])
}

enum AgentStatus {
  ACTIVE
  RETIRED
}

// 每次 Agent 内部能力变更（换 prompt / 装新 skill / 升级 model）登记一条
model AgentSnapshot {
  id          String   @id @default(cuid())
  agentId     String
  version     String // 用户自填，如 "v1.2" / "2026-05-31"
  profileHash String? // 可选：prompt+skill+model 摘要
  changeNotes String?  @db.Text
  capturedAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
}

// ────────────────────────────────────────────────────────────────────────
// FieldRevision · 字段级修订流水
// ────────────────────────────────────────────────────────────────────────
// 每次某条数据的某个字段被改 → 写一条
// 用来回答：
//   - "这条数据原本是 Agent 草拟的什么 → 人最终保留/改成了什么"
//   - "Agent 是基于什么思考链给出的这个判断"
//   - "改稿率 / 判断偏差" 的原始数据来源

model FieldRevision {
  id                   String      @id @default(cuid())
  projectId            String? // 关联 PiaProject（便于按项目反查）
  resource             String // "Risk" | "DataItem" | "Mitigation" | "Conclusion" | "Scenario"
  resourceId           String
  fieldName            String // "name" | "likelihood" | "legalReasoning" | ...
  oldValue             String?     @db.Text
  newValue             String?     @db.Text
  /// JSON · Agent 思考链 { read[], considered[], chose, why }
  reasoning            String?     @db.Text
  actorType            ActorType
  actorUserId          String? // 当 actorType=HUMAN
  actorAgentId         String? // 当 actorType=AGENT
  actorAgentSnapshotId String? // 当 actorType=AGENT 时附带 snapshot
  source               AuditSource
  createdAt            DateTime    @default(now())

  project PiaProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([resource, resourceId])
  @@index([actorAgentId])
  @@index([actorUserId])
}

enum ActorType {
  HUMAN
  AGENT
  SYSTEM // seed/migration/cron 等
}

// ────────────────────────────────────────────────────────────────────────
// Evaluation · 一等动作 · 4 种关系（人↔人 / 人↔Agent / Agent↔人 / Agent↔Agent）
// ────────────────────────────────────────────────────────────────────────

model Evaluation {
  id                       String                @id @default(cuid())
  organizationId           String
  evaluatorType            ActorType
  evaluatorUserId          String?
  evaluatorAgentId         String?
  evaluatorAgentSnapshotId String?
  subjectType              EvaluationSubjectType
  /// 当 subject 是 USER → User.id
  /// 当 subject 是 AGENT → Agent.id
  /// 当 subject 是 RECORD → "${resource}:${resourceId}"
  subjectRef               String
  /// 1-5 分；可选
  score                    Int?
  comment                  String?               @db.Text
  payload                  String?               @db.Text // JSON · 任何额外结构化数据
  createdAt                DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([subjectType, subjectRef])
  @@index([evaluatorAgentId])
  @@index([evaluatorUserId])
}

enum EvaluationSubjectType {
  USER
  AGENT
  RECORD // 评价某条数据本身（Risk 写得好不好 / 思考链漂不漂亮）
}

enum TokenScope {
  READ_PROJECTS
  WRITE_PROJECTS
  READ_RISKS
  WRITE_RISKS
  READ_MITIGATIONS
  WRITE_MITIGATIONS
  READ_CONCLUSIONS
  WRITE_CONCLUSIONS
  GENERATE_REPORT
  ADMIN // 所有权限
}

// ────────────────────────────────────────────────────────────────────────
// Source · 外部来源指针(私有 git 库 / 飞书文档 / 群聊 / 文件 ...)
// ────────────────────────────────────────────────────────────────────────
// 设计原则:
// - PIA Forge 不存原文,只存指针 + 抓取时的摘要片段
// - 引用时绑定 commit sha / message id 等版本标识,老引用不腐烂
// - 监管追溯时能看「引用了什么 · 当时是这样」,但看不到你私有库全文

model Source {
  id                  String      @id @default(cuid())
  organizationId      String
  type                SourceType
  uri                 String // 含版本/锚点的稳定标识,如 github://repo/path@sha
  title               String?
  /// 抓取时的摘要片段 · 防原文失效后留痕断链
  excerpt             String?     @db.Text
  /// 缓存的完整正文(markdown) · 给系统内预览用 · 不强制有
  body                String?     @db.Text
  /// 归属哪个知识库(可空 · 比如临时引用的 URL 可以不归属)
  knowledgeBaseId     String?
  capturedAt          DateTime    @default(now())
  capturedByActorType ActorType?
  capturedByUserId    String?
  capturedByAgentId   String?
  scope               SourceScope @default(PROJECT)
  /// 关联到某个评估(scope=PROJECT 时填)
  projectId           String?
  /// 自由标签(法规编号 / 章节号 / 业务标签)
  tags                String[]

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  citations     CitationLink[]

  @@unique([organizationId, uri])
  @@index([organizationId])
  @@index([type])
  @@index([projectId])
  @@index([knowledgeBaseId])
}

enum SourceType {
  GITHUB_FILE // github://repo/path@sha
  FEISHU_DOC
  FEISHU_MESSAGE
  FEISHU_WIKI
  FEISHU_SHEET
  FEISHU_BASE
  EMAIL
  FILE // 上传的本地文件(走 OSS)
  URL // 公网 URL · 政府公报 / 监管原文
  AGENT_MEMORY // Agent 自己的 memory snapshot
  EXTERNAL_API
  OTHER
}

enum SourceScope {
  PRIVATE // 仅 capturedBy 可见
  PROJECT // 挂在某个评估上
  TEAM // 团队可见(部门 wiki / 内部沟通)
  ORG // 全 org 可引用(法规 / 国标)
}

// CitationLink · 合规判断 → Source 的引用关系
model CitationLink {
  id               String       @id @default(cuid())
  /// 引用方:Risk / DataItem / Mitigation / Conclusion / PiaProject
  fromType         String
  fromId           String
  toSourceId       String
  citationType     CitationType
  /// 引用时的具体片段 · 为啥引这个
  excerpt          String?      @db.Text
  citedByActorType ActorType
  citedByUserId    String?
  citedByAgentId   String?
  citedAt          DateTime     @default(now())

  source Source @relation(fields: [toSourceId], references: [id], onDelete: Cascade)

  @@index([fromType, fromId])
  @@index([toSourceId])
}

enum CitationType {
  EVIDENCE // 这是判断的依据
  DERIVED_FROM // 这是经过此源讨论后产出
  DISCUSSED_IN // 在这里被讨论过
  SIGNED_OFF_IN // 在这里签字
  CONTRADICTED_BY // 这跟我的判断冲突
  REFERENCE // 一般性参考
}

// ────────────────────────────────────────────────────────────────────────
// KnowledgeBase · 知识库连接配置
// ────────────────────────────────────────────────────────────────────────
// 公共/个人知识库的「物理位置」配置
// 不存内容,只存「在哪里」+「怎么访问」
// 内容仍在 GitHub / 飞书 / 文件系统等原始位置

model KnowledgeBase {
  id             String             @id @default(cuid())
  organizationId String
  name           String // "黄越的合规知识库"
  description    String?            @db.Text
  type           KnowledgeBaseType
  /// 物理位置标识
  /// GITHUB_REPO: "juejiangxiaopianzi/huangyue-compliance-kb"
  /// FEISHU_SPACE: "7074424220893085697"
  /// LOCAL_DIR: "/Users/xx/knowledge"
  /// URL: "https://..."
  uri            String
  scope          KnowledgeBaseScope @default(PRIVATE)
  /// 所有者 user · scope=PRIVATE 时仅这个人能读
  ownerUserId    String?
  /// 最近一次同步时间
  lastSyncedAt   DateTime?
  /// 同步策略(预留 v0.2)
  syncStrategy   String?            @default("manual")
  /// 是否激活
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  indexes      KnowledgeIndex[]
  Source       Source[]

  @@index([organizationId])
  @@index([ownerUserId])
}

enum KnowledgeBaseType {
  GITHUB_REPO // 私有 git repo (黄越的 huangyue-compliance-kb 这种)
  FEISHU_SPACE // 飞书知识空间
  FEISHU_WIKI // 飞书 wiki(更细)
  LOCAL_DIR // 本地目录(用户自己维护)
  NOTION
  OBSIDIAN
  URL_LIST // 一组公网 URL
  OTHER
}

enum KnowledgeBaseScope {
  PRIVATE // 仅 owner 可见(个人知识库)
  TEAM // 团队可见
  ORG // 全 org 可见(公共知识库)
}

// ────────────────────────────────────────────────────────────────────────
// KnowledgeIndex · 索引一等公民
// ────────────────────────────────────────────────────────────────────────
// "Agent 知道这事在哪/找谁问"
// 每条索引 = 一个查询关键词 → 一个/多个指向
//   - 指向 Source(具体文档/消息)
//   - 指向 LegalReference(法规)
//   - 指向 另一个 Agent("问王某某的 Agent")

model KnowledgeIndex {
  id              String             @id @default(cuid())
  organizationId  String
  knowledgeBaseId String? // 属于哪个知识库(可空,表示独立索引)
  /// 查询关键词 / 主题
  topic           String
  /// 索引描述 · "数据出境相关判断在 XX 文档"
  description     String?            @db.Text
  /// 指向哪里(多对一)
  /// 用 JSON 数组存指针: [{type:"SOURCE", id:"xxx"}, {type:"LEGAL", id:"xxx"}, {type:"AGENT", id:"xxx"}]
  pointers        String             @db.Text
  /// 维护者(谁建的这条索引)
  ownerUserId     String?
  ownerAgentId    String?
  scope           KnowledgeBaseScope @default(PRIVATE)
  hitCount        Int                @default(0)
  lastHitAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ownerUserId])
  @@index([ownerAgentId])
  @@index([topic])
}

// ────────────────────────────────────────────────────────────────────────
// InviteCode · 邀请码 · 黄越发码,被邀请人 /signup?code=xxx 注册
// ────────────────────────────────────────────────────────────────────────

model InviteCode {
  id              String           @id @default(cuid())
  organizationId  String
  /// 短码 · 例如 ABC-7K9 · @@unique
  code            String           @unique
  /// 备注 · 给谁用 · 显示在管理页
  note            String?
  /// 创建者
  createdByUserId String
  /// 已用 by 谁 · 一个码对一个 user
  usedByUserId    String?          @unique
  usedAt          DateTime?
  /// 过期时间 · null = 永久
  expiresAt       DateTime?
  status          InviteCodeStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreator", fields: [createdByUserId], references: [id])
  usedBy       User?        @relation("InviteUsedBy", fields: [usedByUserId], references: [id])

  @@index([organizationId])
  @@index([status])
}

enum InviteCodeStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}
